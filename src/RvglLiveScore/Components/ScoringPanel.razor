@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<aside class="scoring-panel" aria-label="Scoring settings">
    <div class="scoring-header">
        <h2 class="panel-heading">
            <button type="button" class="panel-toggle" aria-expanded="@_expanded.ToString().ToLowerInvariant()"
                    aria-controls="scoring-content" @onclick="() => _expanded = !_expanded">
                <svg class="chevron @(_expanded ? "" : "is-collapsed")" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                    <path d="m5 7 4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>Scoring System</span>
            </button>
        </h2>
        @if (!_expanded)
        {
            <span class="scoring-selected">@(_preset == "io" ? "IO" : "Custom")</span>
        }
    </div>
    <div id="scoring-content" class="scoring-content" hidden="@(!_expanded)">
      <div class="scoring-preset-row">
        <label class="sr-only" for="scoring-preset">Scoring preset</label>
        <select id="scoring-preset" value="@_preset" @onchange="ChangePreset" disabled="@(!_ready || _busy)">
            <option value="io">IO</option>
            <option value="custom">Custom</option>
        </select>
      </div>
      @if (_preset == "io")
      {
        <p class="io-description"><span>The winner earns one point per starter</span><span>Each following place earns one point less</span></p>
      }
      else
      {
        <div class="file-actions" role="group" aria-label="Scoring file">
            <label class="import-button" title="Import a scoring JSON file">
                <span aria-hidden="true">↓</span> Import
                <InputFile OnChange="Import" accept=".json,application/json" aria-label="Import scoring file" disabled="@(!_ready || _busy)" />
            </label>
            <button type="button" @onclick="Export" disabled="@(!_ready || _busy)"><span aria-hidden="true">↑</span> Export</button>
        </div>
        <table class="scoring-table">
            <thead><tr><th scope="col">Place</th><th scope="col">Points</th></tr></thead>
            <tbody>
                @for (var i = 0; i < ScoringSystem.PlaceCount; i++)
                {
                    var index = i;
                    <tr>
                        <th scope="row">@(index + 1)</th>
                        <td><input type="text" inputmode="decimal" autocomplete="off" spellcheck="false"
                                   aria-label="@($"Points for place {index + 1}")" value="@_fields[index]"
                                   maxlength="16" disabled="@(!_ready || _busy)" @oninput="e => Edit(index, e.Value?.ToString() ?? string.Empty)" /></td>
                    </tr>
                }
            </tbody>
        </table>
      }
        @if (_error is not null)
        {
            <p class="validation-message" role="alert">@_error</p>
        }
        @if (_notice is not null)
        {
            <p class="panel-notice" role="status">@_notice</p>
        }
        <div class="apply-row"><button type="button" class="apply-button" @onclick="Apply" disabled="@(!_ready || _busy)">Apply</button></div>
    </div>
</aside>

@code {
    [Parameter, EditorRequired] public string LobbyId { get; set; } = "";
    [Parameter] public EventCallback<ScoringSystem> Applied { get; set; }
    [Parameter] public bool StartCollapsed { get; set; }
    private string[] _fields = ScoringSystem.CustomDefault.Points.Select(ScoringSystem.Format).ToArray();
    private string _preset = "io";
    private bool _expanded = true;
    private bool _ready;
    private bool _busy;
    private bool _disposed;
    private string? _error;
    private string? _notice;
    private IJSObjectReference? _module;
    private bool? _lastStartCollapsed;

    protected override void OnParametersSet()
    {
        if (_lastStartCollapsed == StartCollapsed) return;
        _expanded = !StartCollapsed;
        _lastStartCollapsed = StartCollapsed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./scoring.js");
            var json = await _module.InvokeAsync<string?>("loadScoring", LobbyId);
            if (_disposed) return;
            if (json is not null)
            {
                var scoring = ScoringSystem.FromJson(json);
                SetFields(scoring);
                await Applied.InvokeAsync(scoring);
            }
        }
        catch (FormatException) { _notice = "Saved settings could not be read. Using IO scoring."; }
        catch (JSException) { _notice = "Browser storage is unavailable. Settings can still be used for this visit."; }
        finally
        {
            if (!_disposed)
            {
                _ready = true;
                StateHasChanged();
            }
        }
    }

    private void SetFields(ScoringSystem scoring)
    {
        if (!scoring.IsIo) _fields = scoring.Points.Select(ScoringSystem.Format).ToArray();
        _preset = scoring.IsIo ? "io" : "custom";
    }

    private void ChangePreset(ChangeEventArgs args)
    {
        _preset = args.Value?.ToString() ?? "custom";
        _error = null;
        _notice = null;
    }

    private void Edit(int index, string value)
    {
        _fields[index] = value;
        _preset = "custom";
        _error = null;
        _notice = null;
    }

    private async Task Apply()
    {
        _error = null;
        try
        {
            var scoring = _preset == "io" ? ScoringSystem.IO : ScoringSystem.FromFields(_fields);
            await Applied.InvokeAsync(scoring);
            var saved = _module is not null && await _module.InvokeAsync<bool>("saveScoring", LobbyId, scoring.ToJson());
            _notice = saved ? null : "Browser storage is unavailable. Settings will last for this visit.";
            _preset = scoring.IsIo ? "io" : "custom";
        }
        catch (FormatException exception) { _error = exception.Message; _notice = null; }
        catch (JSException) { _notice = "Could not save settings to this browser. They will last for this visit."; }
    }

    private async Task Import(InputFileChangeEventArgs args)
    {
        _busy = true;
        _error = null;
        _notice = null;
        try
        {
            await using var stream = args.File.OpenReadStream(ScoringSystem.MaxFileBytes);
            using var reader = new StreamReader(stream);
            var scoring = ScoringSystem.FromJson(await reader.ReadToEndAsync());
            SetFields(scoring);
            _notice = null;
        }
        catch (FormatException exception) { _error = exception.Message; }
        catch (IOException) { _error = "Could not read the file. Choose a JSON file smaller than 16 KB."; }
        finally { _busy = false; }
    }

    private async Task Export()
    {
        _error = null;
        _notice = null;
        try
        {
            var scoring = ScoringSystem.FromFields(_fields);
            if (_module is null) throw new JSException("File downloads are unavailable.");
            await _module.InvokeVoidAsync("downloadScoring", scoring.ToJson());
            _notice = "Exported the values shown above.";
        }
        catch (FormatException exception) { _error = exception.Message; }
        catch (JSException) { _error = "Could not download the scoring file. Please reload and try again."; }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
