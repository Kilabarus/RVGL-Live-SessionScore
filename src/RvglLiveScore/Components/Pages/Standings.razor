@page "/lobbies/{LobbyId}"
@layout StandingsLayout
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject CoordinatorSessionClient Coordinator
@inject CoordinatorSessionMetadataClient Metadata
@inject LobbyDirectory Directory

<PageTitle>@LobbyName — RVGL</PageTitle>
<a class="back-link" href="/">
    <svg class="back-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M16 10H4m0 0 5-5m-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>Active lobbies</span>
</a>

<div class="standings-grid @LayoutClass">
    <div class="standings-heading">
        <div class="standings-title-row">
            <h1 class="standings-title">@LobbyName</h1>
            @if (_mode == SessionMode.TmFinalist && _update.Results?.CurrentTrack is { } currentTrack)
            {
                <p class="current-track">Current track — @currentTrack</p>
            }
        </div>
        @if (_mode == SessionMode.Classic
            && _update.Connection == SessionConnection.Live
            && (_update.Results?.NextTrack is not null || _update.Results?.RemainingRaces is > 0))
        {
            <div class="queue-summary">
                @if (_update.Results?.NextTrack is { } nextTrack)
                {
                    <p class="next-track">Next track — @nextTrack</p>
                }
                @if (_update.Results?.RemainingRaces is int remainingRaces && remainingRaces > 0)
                {
                    <p class="remaining-races">Remaining races — @remainingRaces</p>
                }
            </div>
        }
    </div>
    <section class="results" aria-label="Session standings">
        @if (StatusMessage is { } message)
        {
            <p class="connection-message" role="status">@message</p>
        }
        <div class="table-scroll" role="region" aria-label="Standings table" tabindex="0">
            <table class="standings-table @TableClass">
                @if (_mode == SessionMode.TmFinalist)
                {
                <colgroup>
                    <col class="tm-position-column" />
                    <col class="tm-player-column" />
                    <col class="tm-points-column" />
                    <col class="tm-last-round-column" />
                    @if (_tmOptions.BestLapBonusEnabled)
                    {
                        <col class="tm-best-lap-column" />
                    }
                    @if (_tmOptions.PodiumBonusEnabled)
                    {
                        <col class="tm-podium-column" />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col" class="position">Pos</th>
                        <th scope="col" class="player">Player</th>
                        <th scope="col">Points</th>
                        <th scope="col">Last round<br />points</th>
                        @if (_tmOptions.BestLapBonusEnabled)
                        {
                            <th scope="col">Best lap<br />on current track</th>
                        }
                        @if (_tmOptions.PodiumBonusEnabled)
                        {
                            <th scope="col">Podium bonus<br />on current track</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _tmStandings)
                    {
                        <tr @key="row.Player">
                            <td class="position">@row.Position</td>
                            <th scope="row" class="player">@row.Player</th>
                            <td class="points @(row.Status == TmFinalistStatus.Winner ? "status-winner" : row.Status == TmFinalistStatus.Finalist ? "status-finalist" : "")">
                                @(row.Status == TmFinalistStatus.Winner ? "WINNER" : row.Status == TmFinalistStatus.Finalist ? "FINALIST" : ScoringSystem.Format(row.Points))
                            </td>
                            <td class="last-round-cell">@FormatLastRound(row.LastRoundParts)</td>
                            @if (_tmOptions.BestLapBonusEnabled)
                            {
                                <td class="best-lap-cell @(row.BestLapMilliseconds is > 0 && row.BestLapMilliseconds == FastestLap ? "fastest-lap" : "")">
                                    @(row.BestLapMilliseconds is int lap ? TmFinalistCalculator.FormatLap(lap) : "—")
                                </td>
                            }
                            @if (_tmOptions.PodiumBonusEnabled)
                            {
                                <td class="podium-cell">@(row.PodiumEligible ? "✓" : "")</td>
                            }
                        </tr>
                    }
                    @if (_tmStandings.Count == 0)
                    {
                        <tr><td colspan="@TmColumnCount" class="empty-standings">@EmptyMessage</td></tr>
                    }
                </tbody>
                }
                else if (_mode == SessionMode.RvQuickDrawTournament2026)
                {
                <colgroup>
                    <col class="quick-position-column" />
                    <col class="quick-player-column" />
                    <col class="quick-race-column" />
                    <col class="quick-race-column" />
                    <col class="quick-race-column" />
                    <col class="quick-race-column" />
                    <col class="quick-points-column" />
                    <col class="quick-difference-column" />
                    <col class="quick-difference-column" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col" class="position">Pos</th>
                        <th scope="col" class="player">Player</th>
                        <th scope="col">Heat Race #1</th>
                        <th scope="col">Heat Race #2</th>
                        <th scope="col">Heat Race #3</th>
                        <th scope="col">Final Race</th>
                        <th scope="col" class="points">Points</th>
                        <th scope="col" title="Points behind the player above">Diff</th>
                        <th scope="col" title="Points behind the leader">Diff Leader</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _quickDrawStandings)
                    {
                        <tr @key="row.Player">
                            <td class="position">@row.Position</td>
                            <th scope="row" class="player">@row.Player</th>
                            @foreach (var points in row.RacePoints)
                            {
                                <td class="race-points">@RacePoints(points)</td>
                            }
                            <td class="points">@ScoringSystem.Format(row.Points)</td>
                            <td class="difference">@Difference(row.Diff)</td>
                            <td class="difference">@Difference(row.DiffLeader)</td>
                        </tr>
                    }
                    @if (_quickDrawStandings.Count == 0)
                    {
                        <tr><td colspan="9" class="empty-standings">@EmptyMessage</td></tr>
                    }
                </tbody>
                }
                else
                {
                <colgroup>
                    <col class="position-column" />
                    <col class="player-column" />
                    <col class="points-column" />
                    <col class="wins-column" />
                    <col class="difference-column" />
                    <col class="difference-column" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col" class="position">Pos</th>
                        <th scope="col" class="player">Player</th>
                        <th scope="col" class="points">Points</th>
                        <th scope="col">Wins</th>
                        <th scope="col" title="Points behind the player above">Diff</th>
                        <th scope="col" title="Points behind the leader">Diff Leader</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _standings)
                    {
                        <tr @key="row.Player">
                            <td class="position">@row.Position</td>
                            <th scope="row" class="player">@row.Player</th>
                            <td class="points">@ScoringSystem.Format(row.Points)</td>
                            <td>@row.Wins</td>
                            <td class="difference">@Difference(row.Diff)</td>
                            <td class="difference">@Difference(row.DiffLeader)</td>
                        </tr>
                    }
                    @if (_standings.Count == 0)
                    {
                        <tr><td colspan="6" class="empty-standings">@EmptyMessage</td></tr>
                    }
                </tbody>
                }
            </table>
        </div>
    </section>
    <div class="settings-column">
        @if (_settingsReady)
        {
            @if (SettingsBanner is { } banner && !_bannerDismissed)
            {
                <div class="settings-banner" role="status">
                    <span>@banner</span>
                    <button type="button" aria-label="Dismiss settings message" @onclick="DismissBanner">×</button>
                </div>
            }
            <SessionModePanel @key="ModePanelKey" Changed="SetMode" Value="CurrentModeSelection"
                              Locked="@_settingsLocked" ExternalRevision="@_settingsRevision" />
            @if (_mode != SessionMode.RvQuickDrawTournament2026)
            {
                <ScoringPanel @key="ScoringPanelKey" LobbyId="@LobbyId" Applied="SetScoring" Loaded="SetStoredScoring" Value="@_scoring"
                              Locked="@_settingsLocked" LoadStoredSettings="@_loadStoredScoring"
                              ExternalRevision="@_settingsRevision" StartCollapsed="@(_mode == SessionMode.TmFinalist)" />
            }
        }
    </div>
</div>

@code {
    [Parameter] public string LobbyId { get; set; } = "";
    private SessionUpdate _update = new(null, SessionConnection.Loading);
    private ScoringSystem _scoring = ScoringSystem.IO;
    private IReadOnlyList<Standing> _standings = [];
    private SessionMode _mode = SessionMode.Classic;
    private TmFinalistOptions _tmOptions = new();
    private IReadOnlyList<TmStanding> _tmStandings = [];
    private IReadOnlyList<QuickDrawStanding> _quickDrawStandings = [];
    private CancellationTokenSource? _subscription;
    private Task? _watch;
    private Task? _metadataWatch;
    private string? _watchedId;
    private bool _interactive;
    private bool _disposed;
    private bool _settingsReady;
    private bool _settingsLocked;
    private bool _viewerCustomized;
    private bool _loadStoredScoring;
    private bool _bannerDismissed;
    private string? _description;
    private string? _settingsWarning;
    private string? _bannerIdentity;
    private int _settingsRevision;

    private string LobbyName => _update.Results?.Name
        ?? Directory.Snapshot.Lobbies.FirstOrDefault(x => x.Id == LobbyId)?.Name ?? "Lobby";
    private string ModePanelKey => "mode:" + LobbyId;
    private string ScoringPanelKey => "scoring:" + LobbyId;
    private string LayoutClass => _mode switch
    {
        SessionMode.TmFinalist => "tm-layout",
        SessionMode.RvQuickDrawTournament2026 => "quick-draw-layout",
        _ => ""
    };
    private string TableClass => _mode switch
    {
        SessionMode.TmFinalist => "tm-table",
        SessionMode.RvQuickDrawTournament2026 => "quick-draw-table",
        _ => ""
    };
    private SessionModeSelection CurrentModeSelection => new(_mode, _tmOptions);
    private string? SettingsBanner => _settingsWarning is not null
        ? "Lobby settings could not be loaded: " + _settingsWarning
        : _settingsLocked ? "These settings are locked by the lobby host." : null;
    private int? FastestLap => _tmStandings.Min(row => row.BestLapMilliseconds);
    private int TmColumnCount => 4 + (_tmOptions.BestLapBonusEnabled ? 1 : 0) + (_tmOptions.PodiumBonusEnabled ? 1 : 0);
    private string? StatusMessage => _update.Connection switch
    {
        SessionConnection.Reconnecting => _update.Results is null
            ? "Unable to load results. Retrying automatically…"
            : "Connection lost. Showing the last received results. Reconnecting…",
        SessionConnection.Ended => "Session ended.",
        SessionConnection.Unavailable => "This lobby is no longer available or is private.",
        _ => null
    };
    private string EmptyMessage => _update.Connection switch
    {
        SessionConnection.Loading => "Loading standings…",
        SessionConnection.Unavailable or SessionConnection.Ended => "No results available.",
        SessionConnection.Reconnecting when _update.Results is null => "Waiting for results…",
        _ => "Waiting for the first finish…"
    };

    private static string Difference(decimal? value) => value is null ? "—"
        : value == 0 ? "0" : "−" + ScoringSystem.Format(value.Value);
    private static string FormatLastRound(IReadOnlyList<decimal> parts) => parts.Count == 0
        ? "0" : string.Join(" + ", parts.Select(ScoringSystem.Format));
    private static string RacePoints(decimal? value) => value is null ? "—" : ScoringSystem.Format(value.Value);

    protected override async Task OnParametersSetAsync()
    {
        if (_watchedId == LobbyId) return;
        await StopWatchingAsync();
        _update = new(null, SessionConnection.Loading);
        _scoring = ScoringSystem.IO;
        _standings = [];
        _mode = SessionMode.Classic;
        _tmOptions = new();
        _tmStandings = [];
        _quickDrawStandings = [];
        _settingsReady = false;
        _settingsLocked = false;
        _viewerCustomized = false;
        _loadStoredScoring = false;
        _bannerDismissed = false;
        _description = null;
        _settingsWarning = null;
        _bannerIdentity = null;
        _settingsRevision = 0;
        _watchedId = LobbyId;
        if (_interactive) StartWatching();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _interactive = true;
        StartWatching();
    }

    private void StartWatching()
    {
        _subscription = new();
        var token = _subscription.Token;
        _watch = Coordinator.WatchAsync(LobbyId, update => InvokeAsync(() =>
        {
            if (_disposed || token.IsCancellationRequested) return;
            _update = update;
            if (update.Results is { } results && (!_settingsReady || results.Description is not null))
                ApplyDescription(results.Description);
            Recalculate();
            StateHasChanged();
        }), token);
        _metadataWatch = Metadata.WatchAsync(LobbyId, description => InvokeAsync(() =>
        {
            if (_disposed || token.IsCancellationRequested) return;
            ApplyDescription(description);
            Recalculate();
            StateHasChanged();
        }), token);
    }

    private void SetScoring(ScoringSystem scoring)
    {
        if (_settingsLocked) return;
        _viewerCustomized = true;
        _scoring = scoring;
        Recalculate();
    }

    private void SetStoredScoring(ScoringSystem scoring)
    {
        if (_settingsLocked) return;
        _scoring = scoring;
        Recalculate();
    }

    private void SetMode(SessionModeSelection selection)
    {
        if (_settingsLocked) return;
        _viewerCustomized = true;
        _mode = selection.Mode;
        _tmOptions = selection.Options;
        Recalculate();
    }

    private void Recalculate()
    {
        if (_update.Results is not { } results)
        {
            _standings = [];
            _tmStandings = [];
            _quickDrawStandings = [];
        }
        else if (_mode == SessionMode.Classic)
        {
            _standings = StandingsCalculator.Calculate(results, _scoring);
            _tmStandings = [];
            _quickDrawStandings = [];
        }
        else if (_mode == SessionMode.TmFinalist)
        {
            _tmStandings = TmFinalistCalculator.Calculate(results, _scoring, _tmOptions);
            _standings = [];
            _quickDrawStandings = [];
        }
        else
        {
            _quickDrawStandings = QuickDrawTournamentCalculator.Calculate(results);
            _standings = [];
            _tmStandings = [];
        }
    }

    private void ApplyDescription(string? description)
    {
        if (_settingsReady && string.Equals(_description, description, StringComparison.Ordinal)) return;
        _description = description;
        _settingsRevision++;
        var parsed = LobbySettingsParser.Parse(description);
        _settingsReady = true;
        _loadStoredScoring = !parsed.HasMarker;
        _settingsWarning = parsed.Error;
        _settingsLocked = parsed.Settings?.IsLocked == true;

        var bannerIdentity = _settingsWarning is not null
            ? "error:" + description
            : _settingsLocked ? "locked" : null;
        if (!string.Equals(_bannerIdentity, bannerIdentity, StringComparison.Ordinal))
        {
            _bannerIdentity = bannerIdentity;
            _bannerDismissed = false;
        }

        if (parsed.Settings is { } settings && (!_viewerCustomized || settings.IsLocked))
        {
            _scoring = settings.Scoring;
            _mode = settings.Session.Mode;
            _tmOptions = settings.Session.Options;
            if (settings.IsLocked) _viewerCustomized = false;
        }
        else if (parsed.Settings is null && !_viewerCustomized)
        {
            _scoring = ScoringSystem.IO;
            _mode = SessionMode.Classic;
            _tmOptions = new();
        }
    }

    private void DismissBanner() => _bannerDismissed = true;

    private async Task StopWatchingAsync()
    {
        if (_subscription is null) return;
        await _subscription.CancelAsync();
        if (_watch is not null) await _watch;
        if (_metadataWatch is not null) await _metadataWatch;
        _subscription.Dispose();
        _subscription = null;
        _metadataWatch = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await StopWatchingAsync();
    }
}
