<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#14171c" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes />
    <footer class="site-footer">
        Vibecoded by Kilabarus <span aria-hidden="true">•</span>
        <a href="https://github.com/Kilabarus/RVGL-Live-SessionScore" target="_blank" rel="noopener noreferrer">https://github.com/Kilabarus/RVGL-Live-SessionScore</a>
        <span aria-hidden="true">•</span> Contact in case of any question
    </footer>
    <div id="blazor-error-ui" role="alert">
        The page could not update. <a href="/">Reload</a>
    </div>
    <div id="components-reconnect-modal" role="status" aria-live="polite">
        <span class="reconnect-wait">Reconnecting…</span>
        <span class="reconnect-reload">Connection lost. <a href="/">Reload the page</a></span>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
